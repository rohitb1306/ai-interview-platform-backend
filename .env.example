SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres, e.g. postgres://user:password@localhost:5432/dbname
DATABASE_URL=sqlite:///db.sqlite3

REDIS_URL=redis://localhost:6379/0

FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# LLM_PROVIDER=gemini|openai (defaults to gemini)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Optional model overrides (defaults: gemini-flash-latest / gemini-embedding-001)
# GEMINI_GENERATION_MODEL=
# GEMINI_EMBEDDING_MODEL=
OPENAI_API_KEY=

# Email: DEBUG=True prints emails to the terminal; DEBUG=False sends via SMTP below.
# Uncomment to force a backend regardless of DEBUG.
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@example.com

# SMTP, required when DEBUG=False. For Gmail, EMAIL_HOST_PASSWORD is an App Password
# (myaccount.google.com/apppasswords), not your normal password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
